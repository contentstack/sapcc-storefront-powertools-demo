# Copy to .env (gitignored) and fill in your own stack's values for local dev.
# On a hosting platform, set these as real environment variables instead —
# no .env file needed there.

CS_API_KEY=<STACK_API_KEY>
CS_DELIVERY_TOKEN=<DELIVERY_TOKEN>
CS_ENVIRONMENT=development
# US, EU, AU, AZURE_NA, AZURE_EU, GCP_NA, GCP_EU
CS_REGION=US
# CS_BRANCH=main

# Live Preview / Visual Builder. Needs a preview token (Settings > Tokens).
# The preview host defaults from CS_REGION; set CS_PREVIEW_HOST only to override it.
CS_LIVE_PREVIEW=false
CS_PREVIEW_TOKEN=
# CS_PREVIEW_HOST=
# Only for a dedicated preview deployment (never the shopper site): lets Live
# Preview run in a production build when the page is opened inside Visual Builder.
# CS_LIVE_PREVIEW_ALLOW_IN_PRODUCTION=false
